{
	"name": "desktop",
	"productName": "CC Work History",
	"version": "0.1.0",
	"description": "Claude Code のセッションログから作業履歴を可視化するデスクトップアプリ",
	"private": true,
	"main": "out/main/index.js",
	"scripts": {
		"dev": "install-electron && electron-vite dev",
		"build": "electron-vite build",
		"dist": "electron-vite build && electron-builder",
		"dist:mac": "electron-vite build && electron-builder --mac",
		"dist:win": "electron-vite build && electron-builder --win",
		"dist:linux": "electron-vite build && electron-builder --linux",
		"preview": "install-electron && electron-vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
		"lint": "biome check .",
		"test:unit": "vitest run --dir test/unit",
		"test:coverage": "vitest run --coverage",
		"test:integration": "vitest run --dir test/integration",
		"depcruise": "depcruise src --config .dependency-cruiser.cjs"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"chokidar": "^4.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.474.0",
		"radix-ui": "^1.6.7",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwind-merge": "^3.7.0",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.18.8",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^5.2.0",
		"@vitest/coverage-v8": "^3.2.4",
		"dependency-cruiser": "^16.10.4",
		"electron": "^44.5.1",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"jsdom": "^26.1.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^3.2.4"
	}
}
